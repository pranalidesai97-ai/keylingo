<?xml version="1.0" encoding="utf-8"?>
<!--
  KeyLingo mark: two speech bubbles (conversation / two languages); the front one
  carries a geometric K in the brand gradient with a coral acute accent (as in "á").
  Everything sits inside the 66dp adaptive-icon safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Back bubble: the other language -->
    <path
        android:fillColor="#59FFFFFF"
        android:pathData="M54,28 H70 A10,10 0 0 1 80,38 V48 A10,10 0 0 1 70,58 H69 L77.5,65 L64,58 H54 A10,10 0 0 1 44,48 V38 A10,10 0 0 1 54,28 Z" />
    <!-- Front bubble -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M39,40 H61 A11,11 0 0 1 72,51 V63 A11,11 0 0 1 61,74 H45 L33.5,80.5 L36.5,72.5 A11,11 0 0 1 28,63 V51 A11,11 0 0 1 39,40 Z" />
    <!-- K -->
    <path
        android:strokeWidth="5.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M42,52.5 V69.5 M55,52.5 L44.5,61.5 L55.5,69.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="40" android:startY="51.5"
                android:endX="58" android:endY="70.5">
                <item android:offset="0" android:color="#FF1B2A6B" />
                <item android:offset="0.6" android:color="#FF1E78D6" />
                <item android:offset="1" android:color="#FF22A89C" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Acute accent -->
    <path
        android:strokeColor="#FFFF8A65"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M48.5,48.2 L52.5,44.2" />
</vector>
