<resources>
    <string name="app_name">KeyLingo</string>
    <string name="onboarding_title">Set up KeyLingo</string>
    <string name="onboarding_step1_title">1. Enable the keyboard</string>
    <string name="onboarding_step1_desc">Turn on KeyLingo in your system keyboard list.</string>
    <string name="onboarding_step1_action">Open keyboard settings</string>
    <string name="onboarding_step2_title">2. Switch to KeyLingo</string>
    <string name="onboarding_step2_desc">While typing in any app, tap the keyboard switch icon and choose KeyLingo.</string>
    <string name="onboarding_step2_action">Pick input method</string>
    <string name="onboarding_step3_title">3. Open Settings</string>
    <string name="onboarding_step3_desc">Choose your learning language and customize hints.</string>
    <string name="onboarding_step3_action">Go to KeyLingo settings</string>
    <string name="settings_title">Settings</string>
    <string name="settings_learning_enabled">Enable learning hints</string>
    <string name="settings_learning_enabled_desc">Show vocabulary hints above the keyboard while you type</string>
    <string name="settings_show_number_row">Number row</string>
    <string name="settings_show_number_row_desc">Show a permanent row of digits above the letter keys</string>
    <string name="settings_autocorrect">Autocorrect</string>
    <string name="settings_autocorrect_desc">Fix obvious typos, missing accents and apostrophes when you press space. Press backspace once to undo.</string>
    <string name="settings_haptics">Vibrate on key press</string>
    <string name="settings_haptics_desc">Off by default. Keys always show a visual press effect.</string>
    <string name="settings_sound">Sound on key press</string>
    <string name="settings_sound_desc">Off by default. Plays at your system sound-effects volume.</string>
    <string name="settings_personal_data">Personal learning data</string>
    <string name="settings_personal_data_desc">Words and phrases KeyLingo has learned from your typing are stored only on this device.</string>
    <string name="settings_personal_data_cleared">All learned words and phrases were deleted.</string>
    <string name="settings_personal_data_clear">Delete learned words</string>
    <string name="settings_personal_data_confirm_title">Delete learned words?</string>
    <string name="settings_personal_data_confirm_text">KeyLingo will forget every word and word sequence it learned from you. Bundled dictionaries are not affected. This cannot be undone.</string>
