    <string name="settings_learning_mode">Learning mode</string>
    <string name="learning_mode_beginner_title">Beginner</string>
    <string name="learning_mode_beginner_desc">Show more hints, more translations, and grammar explanations</string>
    <string name="learning_mode_intermediate_title">Intermediate</string>
    <string name="learning_mode_intermediate_desc">Fewer hints, focused on the most important words</string>
    <string name="learning_mode_advanced_title">Advanced</string>
    <string name="learning_mode_advanced_desc">Minimal hints, only for difficult or uncommon words</string>
    <string name="settings_about">About</string>
    <string name="settings_about_desc">KeyLingo teaches you Spanish as you type. Everything runs offline: your keystrokes and learned words never leave this device.</string>
    <string name="settings_section_typing">Typing</string>
    <string name="settings_section_appearance">Appearance</string>
