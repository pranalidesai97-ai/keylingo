    <string name="settings_section_personal">Personal dictionary</string>
    <string name="settings_typing_language">Typing language</string>
    <string name="settings_typing_language_desc">Which dictionary drives suggestions and autocorrect. Auto detects English or Spanish from what you type.</string>
    <string name="settings_typing_language_auto">Auto-detect</string>
    <string name="settings_typing_language_en">English</string>
    <string name="settings_typing_language_es">Spanish</string>
    <string name="settings_grammar">Grammar suggestions</string>
    <string name="settings_grammar_desc">Offer a corrected English sentence after you finish a word. Nothing changes unless you tap it.</string>
    <string name="settings_sentence_translation">Sentence translation</string>
    <string name="settings_sentence_translation_desc">Show the whole sentence translated when every word is understood.</string>
    <string name="settings_learned_words">Learned words</string>
    <string name="settings_learned_words_desc">See and delete the words KeyLingo learned from your typing. Words typed only once or twice are forgotten after 30 days.</string>
